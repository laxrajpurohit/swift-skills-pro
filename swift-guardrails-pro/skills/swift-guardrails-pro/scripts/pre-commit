#!/bin/bash
# Git pre-commit suite, for commits made outside Claude Code (Claude's own
# commits are already covered by the plugin hook). install-hooks.sh wires it up.
#
#   1. pbxproj-scan.sh   blocks build-phase injection in Xcode project files
#   2. lint-changed.sh   SwiftLint on staged lines
#   3. dup-check.sh      copy-paste on staged lines (SKIP_DUP_CHECK=1 to bypass)
#
# A missing tool or a repo without Swift code skips the step instead of blocking.

DIR="$(cd "$(dirname "$0")" && pwd)"

run() {
  bash "$@"
  [ $? -eq 1 ] && exit 1
  return 0
}

run "$DIR/pbxproj-scan.sh"
command -v swiftlint >/dev/null 2>&1 && run "$DIR/lint-changed.sh" --staged
if [ "${SKIP_DUP_CHECK:-0}" != "1" ] && command -v jscpd >/dev/null 2>&1; then
  run "$DIR/dup-check.sh" --staged
fi
exit 0
